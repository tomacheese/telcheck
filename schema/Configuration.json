{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Conditions": {
            "properties": {
                "callerNumber": {
                    "type": "string"
                },
                "direction": {
                    "type": "string"
                },
                "selfNumber": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "DestinationDiscordBot": {
            "properties": {
                "channel_id": {
                    "description": "通知先の Discord チャンネル ID",
                    "type": "string"
                },
                "token": {
                    "description": "Discord Bot のトークン",
                    "type": "string"
                },
                "type": {
                    "const": "discord-bot",
                    "type": "string"
                }
            },
            "required": [
                "channel_id",
                "token",
                "type"
            ],
            "type": "object"
        },
        "DestinationDiscordWebhook": {
            "properties": {
                "type": {
                    "const": "discord-webhook",
                    "type": "string"
                },
                "webhook_url": {
                    "description": "Discord Webhook URL",
                    "type": "string"
                }
            },
            "required": [
                "type",
                "webhook_url"
            ],
            "type": "object"
        },
        "DestinationLINENotify": {
            "properties": {
                "token": {
                    "description": "LINE Notify のトークン",
                    "type": "string"
                },
                "type": {
                    "const": "line-notify",
                    "type": "string"
                }
            },
            "required": [
                "token",
                "type"
            ],
            "type": "object"
        },
        "DestinationSlack": {
            "properties": {
                "type": {
                    "const": "slack",
                    "type": "string"
                },
                "webhook_url": {
                    "description": "Slack Incoming Webhook URL",
                    "type": "string"
                }
            },
            "required": [
                "type",
                "webhook_url"
            ],
            "type": "object"
        },
        "DestinationWebPush": {
            "properties": {
                "type": {
                    "const": "web-push",
                    "type": "string"
                }
            },
            "required": [
                "type"
            ],
            "type": "object"
        },
        "IDestination": {
            "anyOf": [
                {
                    "allOf": [
                        {
                            "$ref": "#/definitions/DestinationDiscordWebhook"
                        },
                        {
                            "properties": {
                                "condition": {
                                    "$ref": "#/definitions/Conditions",
                                    "description": "この宛先へ通知する条件 (正規表現)"
                                },
                                "name": {
                                    "description": "宛先名",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "condition",
                                "name"
                            ],
                            "type": "object"
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/definitions/DestinationDiscordBot"
                        },
                        {
                            "properties": {
                                "condition": {
                                    "$ref": "#/definitions/Conditions",
                                    "description": "この宛先へ通知する条件 (正規表現)"
                                },
                                "name": {
                                    "description": "宛先名",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "condition",
                                "name"
                            ],
                            "type": "object"
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/definitions/DestinationSlack"
                        },
                        {
                            "properties": {
                                "condition": {
                                    "$ref": "#/definitions/Conditions",
                                    "description": "この宛先へ通知する条件 (正規表現)"
                                },
                                "name": {
                                    "description": "宛先名",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "condition",
                                "name"
                            ],
                            "type": "object"
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/definitions/DestinationLINENotify"
                        },
                        {
                            "properties": {
                                "condition": {
                                    "$ref": "#/definitions/Conditions",
                                    "description": "この宛先へ通知する条件 (正規表現)"
                                },
                                "name": {
                                    "description": "宛先名",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "condition",
                                "name"
                            ],
                            "type": "object"
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/definitions/DestinationWebPush"
                        },
                        {
                            "properties": {
                                "condition": {
                                    "$ref": "#/definitions/Conditions",
                                    "description": "この宛先へ通知する条件 (正規表現)"
                                },
                                "name": {
                                    "description": "宛先名",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "condition",
                                "name"
                            ],
                            "type": "object"
                        }
                    ]
                }
            ]
        },
        "Self": {
            "properties": {
                "condition": {
                    "$ref": "#/definitions/Conditions",
                    "description": "この名前に該当する条件 (正規表現)"
                },
                "name": {
                    "description": "自分の電話番号の名前",
                    "type": "string"
                }
            },
            "required": [
                "condition",
                "name"
            ],
            "type": "object"
        }
    },
    "properties": {
        "destinations": {
            "items": {
                "$ref": "#/definitions/IDestination"
            },
            "type": "array"
        },
        "google_search": {
            "properties": {
                "cx": {
                    "description": "Google Custom Search の検索エンジン ID (CX)",
                    "type": "string"
                },
                "key": {
                    "description": "Google Custom Search の API キー",
                    "type": "string"
                }
            },
            "required": [
                "cx",
                "key"
            ],
            "type": "object"
        },
        "router": {
            "properties": {
                "ip": {
                    "description": "ルーターの IP アドレス",
                    "type": "string"
                },
                "password": {
                    "description": "ルーターのパスワード",
                    "type": "string"
                },
                "username": {
                    "description": "ルーターのユーザー名",
                    "type": "string"
                }
            },
            "required": [
                "ip",
                "password",
                "username"
            ],
            "type": "object"
        },
        "selfs": {
            "items": {
                "$ref": "#/definitions/Self"
            },
            "type": "array"
        },
        "web": {
            "properties": {
                "auth": {
                    "description": "Web サーバーの認証設定",
                    "properties": {
                        "password": {
                            "description": "Web サーバーの認証パスワード",
                            "type": "string"
                        },
                        "username": {
                            "description": "Web サーバーの認証ユーザー名",
                            "type": "string"
                        }
                    },
                    "required": [
                        "password",
                        "username"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "auth"
            ],
            "type": "object"
        }
    },
    "required": [
        "destinations",
        "router",
        "selfs"
    ],
    "type": "object"
}

