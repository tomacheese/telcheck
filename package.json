{
  "name": "telcheck",
  "version": "2.0.0",
  "description": "Check caller and notify to discord for NVR510",
  "homepage": "https://github.com/tomacheese/telcheck",
  "bugs": {
    "url": "https://github.com/tomacheese/telcheck/issues"
  },
  "license": "MIT",
  "author": "Tomachi",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "url": "git@github.com:tomacheese/telcheck.git",
    "type": "git"
  },
  "scripts": {
    "generate-schema": "typescript-json-schema --required tsconfig.json Configuration -o schema/Configuration.json",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "dev": "tsx watch ./src/main.ts",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "fix": "run-z fix:prettier,fix:eslint"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.46",
    "@book000/node-utils": "1.25.67",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cors": "11.3.0",
    "@types/cheerio": "1.0.0",
    "@types/node": "24.13.3",
    "@types/web-push": "3.6.4",
    "cheerio": "1.2.0",
    "eslint": "10.9.1",
    "eslint-config-standard": "17.1.0",
    "fastify": "5.12.1",
    "prettier": "3.9.6",
    "run-z": "2.1.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-json-schema": "0.68.0",
    "web-push": "3.6.7"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
