{
  "name": "telcheck",
  "version": "2.0.0",
  "description": "Check caller and notify to discord for NVR510",
  "homepage": "https://github.com/tomacheese/telcheck",
  "bugs": {
    "url": "https://github.com/tomacheese/telcheck/issues"
  },
  "license": "MIT",
  "author": "Tomachi",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "url": "git@github.com:tomacheese/telcheck.git",
    "type": "git"
  },
  "scripts": {
    "generate-schema": "typescript-json-schema --required tsconfig.json Configuration -o schema/Configuration.json",
    "lint:prettier": "prettier --check src",
    "lint:tsc": "tsc",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "fix:prettier": "prettier --write src",
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/main.ts",
    "dev": "tsx watch ./src/main.ts",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "fix": "run-z fix:prettier,fix:eslint"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.54",
    "@book000/node-utils": "1.25.81",
    "@fastify/basic-auth": "6.3.0",
    "@fastify/cors": "11.3.0",
    "@types/cheerio": "1.0.0",
    "@types/node": "24.13.3",
    "@types/web-push": "3.6.4",
    "cheerio": "1.2.0",
    "eslint": "10.9.1",
    "eslint-config-standard": "17.1.0",
    "fastify": "5.12.1",
    "prettier": "3.9.6",
    "run-z": "2.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-json-schema": "0.68.0",
    "web-push": "3.6.7"
  },
  "packageManager": "pnpm@12.3.0+sha512.d7bd39a488131de200aeec1dbc9ca58b890437f09b1f925b1bf820fdc463df01a329e3699c3d8a7bb186d5cf3f75cb68ce820c69d6b2c983525bc0821de4c529"
}
